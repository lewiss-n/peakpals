# ---- Database (used by docker compose) ----
POSTGRES_DB=peakpals
POSTGRES_USER=peakpals
POSTGRES_PASSWORD=change-me-to-a-long-random-password

# For running without Docker (npm run dev / start), point this at your database:
DATABASE_URL=postgres://peakpals:change-me-to-a-long-random-password@localhost:5432/peakpals

# ---- Security ----
# Long random string used to sign admin sessions. Generate one with: openssl rand -base64 48
AUTH_SECRET=replace-with-a-long-random-string-at-least-32-characters
# Set to true when the site is served over HTTPS
COOKIE_SECURE=false

# ---- First admin account (created on first start if no admin exists) ----
ADMIN_EMAIL=admin@peakpals.co.ke
ADMIN_PASSWORD=change-this-password
ADMIN_NAME=Peak Pals Admin

# ---- Site ----
SITE_URL=http://localhost:3000
# Your domain, for automatic HTTPS with: docker compose --profile https up -d
DOMAIN=
WEB_PORT=3000

# Where uploads are stored when running without Docker
UPLOAD_DIR=./data/uploads

# true = add sample events and the starter photo album on first start (only when the database is empty)
SEED_DEMO=true
